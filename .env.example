# Set these in the host environment. server.js does not automatically read .env.
HOST=127.0.0.1
PORT=8787
NEWS_DATA_DIR=./var/news
NEWS_POLL_INTERVAL_MS=60000
NEWS_SOURCE_TIMEOUT_MS=15000
# Set true ONLY when NEWS_DATA_DIR is on a verified persistent disk.
NEWS_STORAGE_PERSISTENT=false
# Optional: existing article summaries/translations (not needed for news ingestion).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
